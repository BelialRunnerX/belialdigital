# Public origin used for Stripe redirects and Printful print-file URLs.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123

# Stripe — leave empty to use the local mock checkout desk.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Printful — leave empty to record mock printer jobs in /studio.
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=
PRINTFUL_AUTO_CONFIRM=false
PRINTFUL_WEBHOOK_SECRET=

# Studio desk at /studio
ADMIN_SECRET=devotion

# Set true if you want mock pay available even with Stripe configured.
ALLOW_MOCK_PAY=false
